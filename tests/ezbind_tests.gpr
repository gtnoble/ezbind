with "../ezbind.gpr";
with "config/ezbind_tests_config.gpr";

project Ezbind_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ezbind_Tests_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("ezbind_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ezbind_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("-L/usr/lib/x86_64-linux-gnu", "-lqpdf",
         "-lrsvg-2", "-lgio-2.0", "-lgdk_pixbuf-2.0", "-lgobject-2.0",
         "-lglib-2.0", "-lcairo", "-lpangocairo-1.0", "-lpango-1.0",
         "-pthread");
   end Linker;
end Ezbind_Tests;
